# Application
APP_NAME="OpsKnowledge Agent Lite"
DEBUG=false

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=opsknowledge
POSTGRES_USER=opsuser
POSTGRES_PASSWORD=opspassword

# ── Provider selection ────────────────────────────────────────────────────────
# "openai" — calls the OpenAI-compatible API; requires a real OPENAI_API_KEY.
# "ollama" — (LLM_PROVIDER only) calls a local Ollama server; no OpenAI account
#            needed. For private / on-premise deployment. See OLLAMA_* below.
# "mock"   — deterministic local provider; NO API key needed; safe for CI / local dev.
#            MockEmbeddingProvider returns fixed-dim unit vectors (no network call).
#            MockLLMProvider returns a deterministic answer from retrieved context.
#            Switch to mock mode to verify the full pipeline without any external account.
# Local interview/demo mode defaults to Ollama for the LLM and mock embeddings
# for deterministic local vector search without OpenAI.
EMBEDDING_PROVIDER=ollama
LLM_PROVIDER=ollama
# 向量維度需與 EMBEDDING 模型一致；bge-m3 = 1024。
MOCK_EMBEDDING_DIM=1024
EMBEDDING_DIMENSIONS=1024
# Number of chunks sent to the embedding provider per request during upload.
# Smaller batches are slower overall but avoid local Ollama request timeouts on CPU.
EMBEDDING_BATCH_SIZE=16

# ── OpenAI-compatible LLM ─────────────────────────────────────────────────────
# Only required when EMBEDDING_PROVIDER=openai or LLM_PROVIDER=openai.
# These values are ignored in mock mode. Leave OPENAI_API_KEY empty in mock mode.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# ── Ollama (local LLM provider for private / on-premise deployment) ───────────
# Used only when LLM_PROVIDER=ollama. The app calls the Ollama HTTP API
# (/api/chat) directly — no OpenAI account required. With Docker Compose, pull
# the model into the ollama_data volume using:
#   docker compose exec ollama ollama pull qwen2.5:7b-instruct
#   docker compose exec ollama ollama pull bge-m3
# When EMBEDDING_PROVIDER=ollama, embeddings also come from Ollama (OLLAMA_EMBEDDING_MODEL).
OLLAMA_BASE_URL=http://localhost:11434
# Docker Compose overrides OLLAMA_BASE_URL for the backend container.
# The default points to the bundled ollama service; use host.docker.internal
# only when you intentionally run Ollama on the host instead of compose.
DOCKER_OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
# Multilingual embedding model (cross-lingual retrieval, e.g. English docs + Chinese queries).
# bge-m3 outputs 1024-dim vectors; keep EMBEDDING_DIMENSIONS in sync.
OLLAMA_EMBEDDING_MODEL=bge-m3
# Local models can be slow on CPU, especially on the first request while loading.
OLLAMA_TIMEOUT_SECONDS=180

# ── Reranker (optional second-stage retrieval) ───────────────────────────────
# When true, recall RERANK_CANDIDATE_K chunks from pgvector, then rerank with
# bge-reranker-v2-m3 (served by the `reranker` TEI container) and keep top_k.
# Leave false to use single-stage vector retrieval (no extra container needed).
RERANKER_ENABLED=false
RERANKER_BASE_URL=http://localhost:8080
# Docker Compose overrides RERANKER_BASE_URL for the backend container.
DOCKER_RERANKER_BASE_URL=http://reranker:80
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANK_CANDIDATE_K=30
RERANKER_TIMEOUT_SECONDS=30

# ── Agent (autonomous tool-calling retrieval) ────────────────────────────────
# The /agent-chat endpoint lets the LLM decide whether/what/how-many-times to
# search and which strategy (hybrid/keyword/vector). AGENT_MAX_STEPS caps the
# LLM↔tool round-trips per request to prevent runaway loops.
AGENT_MAX_STEPS=5
